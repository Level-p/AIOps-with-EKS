# ---------------------------------------------------------------------------
# Everything that makes "stage" and "prod" separate environments in one cluster,
# plus the "aiops" namespace. Secrets are created here (not in Git), so Argo CD
# never stores a password.
#
#   1. A namespace per environment, with Pod Security labels
#   2. caresignal-app-secrets: device token (devices -> vitals-ingest), internal
#      token (vitals-ingest/clinical-assistant -> records-api), clinician token
#      (dashboard/API), and the Claude API key of clinical-assistant (if given)
#      (database passwords are generated by the postgres-operator itself)
#   3. One S3 bucket for nightly database backups, a folder per environment
#   4. An IAM role per environment that may ONLY write to its own folder (Pod Identity)
#   5. A ConfigMap telling the backup job where to upload
#   6. The aiops namespace and its secret (Slack webhook, Alertmanager token, Claude API key)
# ---------------------------------------------------------------------------

data "aws_caller_identity" "current" {}
data "aws_region" "current" {}

locals {
  bucket_name = "${var.name}-db-backups-${data.aws_caller_identity.current.account_id}"
  # Must match the Helm chart (templates/backup-cronjob.yaml)
  backup_service_account = "caresignal-db-backup"
}

# ---- 1. Namespaces ----
resource "kubernetes_namespace_v1" "env" {
  for_each = var.environments

  metadata {
    name = "${var.name}-${each.key}"
    labels = {
      "app.kubernetes.io/part-of" = var.name
      environment                 = each.key
      # Pod Security Standards: block privileged pods and warn/audit anything not "restricted"
      # (the PostgreSQL pods of the operator need "baseline"; the apps pass "restricted")
      "pod-security.kubernetes.io/enforce" = "baseline"
      "pod-security.kubernetes.io/warn"    = "restricted"
      "pod-security.kubernetes.io/audit"   = "restricted"
    }
  }
}

# ---- 2. Application secrets ----
resource "random_password" "app" {
  for_each = { for pair in setproduct(keys(var.environments), ["device", "internal", "clinician"]) : "${pair[0]}-${pair[1]}" => pair }
  length   = 40
  special  = false
}

resource "kubernetes_secret_v1" "app" {
  for_each = var.environments

  metadata {
    name      = "${var.name}-app-secrets"
    namespace = kubernetes_namespace_v1.env[each.key].metadata[0].name
  }

  data = merge(
    {
      "device-token"    = random_password.app["${each.key}-device"].result
      "internal-token"  = random_password.app["${each.key}-internal"].result
      "clinician-token" = random_password.app["${each.key}-clinician"].result
    },
    nonsensitive(var.assistant_anthropic_api_key != "") ? { "anthropic-api-key" = var.assistant_anthropic_api_key } : {},
  )
}

# ---- 3. Backup bucket ----
resource "aws_s3_bucket" "backups" {
  bucket        = local.bucket_name
  force_destroy = var.force_destroy_backups

  tags = { Name = local.bucket_name }
}

resource "aws_s3_bucket_public_access_block" "backups" {
  bucket                  = aws_s3_bucket.backups.id
  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

resource "aws_s3_bucket_server_side_encryption_configuration" "backups" {
  bucket = aws_s3_bucket.backups.id
  rule {
    apply_server_side_encryption_by_default {
      sse_algorithm = "AES256"
    }
  }
}

# Versioning: an overwritten or deleted backup can still be recovered
resource "aws_s3_bucket_versioning" "backups" {
  bucket = aws_s3_bucket.backups.id
  versioning_configuration {
    status = "Enabled"
  }
}

# Only HTTPS connections to the bucket
resource "aws_s3_bucket_policy" "backups_tls" {
  bucket = aws_s3_bucket.backups.id
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Sid       = "DenyInsecureTransport"
      Effect    = "Deny"
      Principal = "*"
      Action    = "s3:*"
      Resource  = [aws_s3_bucket.backups.arn, "${aws_s3_bucket.backups.arn}/*"]
      Condition = { Bool = { "aws:SecureTransport" = "false" } }
    }]
  })

  depends_on = [aws_s3_bucket_public_access_block.backups]
}

# Delete old backups automatically, per environment
resource "aws_s3_bucket_lifecycle_configuration" "backups" {
  bucket = aws_s3_bucket.backups.id

  dynamic "rule" {
    for_each = var.environments
    content {
      id     = "expire-${rule.key}"
      status = "Enabled"
      filter {
        prefix = "${rule.key}/"
      }
      expiration {
        days = rule.value.backup_retention_days
      }
      noncurrent_version_expiration {
        noncurrent_days = 7
      }
    }
  }

  depends_on = [aws_s3_bucket_versioning.backups]
}

# ---- 4. Backup IAM roles (EKS Pod Identity) ----
resource "aws_iam_role" "backup" {
  for_each = var.environments
  name     = "${var.name}-${each.key}-db-backup"

  # Only the EKS Pod Identity service may assume this role
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect    = "Allow"
      Principal = { Service = "pods.eks.amazonaws.com" }
      Action    = ["sts:AssumeRole", "sts:TagSession"]
    }]
  })
}

# Least privilege: stage can never touch prod backups, and neither can delete them
resource "aws_iam_role_policy" "backup" {
  for_each = var.environments
  name     = "write-${each.key}-backups"
  role     = aws_iam_role.backup[each.key].id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Sid      = "WriteOwnFolder"
        Effect   = "Allow"
        Action   = ["s3:PutObject"]
        Resource = "${aws_s3_bucket.backups.arn}/${each.key}/*"
      },
      {
        Sid      = "ListOwnFolder"
        Effect   = "Allow"
        Action   = ["s3:ListBucket"]
        Resource = aws_s3_bucket.backups.arn
        Condition = {
          StringLike = { "s3:prefix" = ["${each.key}/*"] }
        }
      }
    ]
  })
}

# Links namespace + ServiceAccount to the IAM role. The ServiceAccount itself is
# created later by the Helm chart (Argo CD); the association waits for it.
resource "aws_eks_pod_identity_association" "backup" {
  for_each        = var.environments
  cluster_name    = var.cluster_name
  namespace       = kubernetes_namespace_v1.env[each.key].metadata[0].name
  service_account = local.backup_service_account
  role_arn        = aws_iam_role.backup[each.key].arn
}

# ---- 5. Where the backup job uploads (read by the chart with envFrom) ----
resource "kubernetes_config_map_v1" "backup" {
  for_each = var.environments

  metadata {
    name      = "db-backup-config"
    namespace = kubernetes_namespace_v1.env[each.key].metadata[0].name
  }

  data = {
    BACKUP_BUCKET = aws_s3_bucket.backups.bucket
    BACKUP_PREFIX = each.key
    AWS_REGION    = data.aws_region.current.region
  }
}

# ---- 6. aiops-engine ----
resource "kubernetes_namespace_v1" "aiops" {
  metadata {
    name = "aiops"
    labels = {
      "app.kubernetes.io/part-of"          = var.name
      "pod-security.kubernetes.io/enforce" = "restricted"
    }
  }
}

# Alertmanager authenticates to aiops-engine with this token
resource "random_password" "aiops_webhook" {
  length  = 40
  special = false
}

resource "kubernetes_secret_v1" "aiops" {
  metadata {
    name      = "aiops-secrets"
    namespace = kubernetes_namespace_v1.aiops.metadata[0].name
  }

  # Empty optional values are left out, so the engine falls back to rule-based triage / log-only
  data = merge(
    { "webhook-token" = random_password.aiops_webhook.result },
    nonsensitive(var.slack_webhook_url != "") ? { "slack-webhook-url" = var.slack_webhook_url } : {},
    nonsensitive(var.anthropic_api_key != "") ? { "anthropic-api-key" = var.anthropic_api_key } : {},
  )
}
