    "colorMode": "background",
    "graphMode": "area"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(http_server_request_duration_seconds_count{k8s_namespace_name=\"$namespace\",http_response_status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_request_duration_seconds_count{k8s_namespace_name=\"$namespace\"}[5m])),1e-6)",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "id": 3
  },
  {
   "type": "stat",
