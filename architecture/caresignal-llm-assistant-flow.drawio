<mxfile host="drawio" type="device"><diagram id="CareSignal clinical assistant" name="CareSignal clinical assistant"><mxGraphModel dx="2150" dy="1180" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2150" pageHeight="1180" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="CareSignal clinical assistant: a grounded, guarded LLM request over one patient record" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1D2433;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="34" as="geometry"/></mxCell><mxCell id="c3" value="Deterministic checks before and after the model · the model only reads one minimised record and returns a schema · clinicians decide and sign" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontStyle=0;fontColor=#5B6475;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1500" height="24" as="geometry"/></mxCell><mxCell id="c4" value="Clinician&lt;br&gt;(dashboard)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=1;aspect=fixed;pointerEvents=1;fillColor=#232F3E;shape=mxgraph.aws4.users;" vertex="1" parent="1"><mxGeometry x="50" y="170" width="56" height="56" as="geometry"/></mxCell><mxCell id="c5" value="ALB&lt;br&gt;/api/assistant" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=1;aspect=fixed;pointerEvents=1;fillColor=#8C4FFF;shape=mxgraph.aws4.application_load_balancer;" vertex="1" parent="1"><mxGeometry x="50" y="400" width="52" height="52" as="geometry"/></mxCell><mxCell id="c6" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#232F3E;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c7" value="clinical-assistant (Node.js)" style="rounded=1;arcSize=3;fillColor=#F7F5FF;strokeColor=#7B61FF;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;fontStyle=1;fontColor=#7B61FF;html=1;whiteSpace=wrap;fontSize=15;" vertex="1" parent="1"><mxGeometry x="230" y="100" width="1470" height="620" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;1 Authenticate&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#5B6475&#x27;&gt;clinician bearer token (constant-time) · rate limit 20/min per credential&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DD344C;strokeWidth=2;fontSize=13;fontColor=#1D2433;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="260" y="160" width="320" height="150" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;2 Question guard&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#5B6475&#x27;&gt;length · control characters · injection and scope patterns → 400, counted (LLM01)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DD344C;strokeWidth=2;fontSize=13;fontColor=#1D2433;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="615" y="160" width="320" height="150" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;3 Read the record&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#5B6475&#x27;&gt;records-api with the clinician&#x27;s token + X-Access-Purpose: audited; no DB access of its own&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#147EBA;strokeWidth=2;fontSize=13;fontColor=#1D2433;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="970" y="160" width="320" height="150" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;4 Minimise&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#5B6475&#x27;&gt;no pseudonym · identifiers redacted · text escaped in &lt;record&gt; · citation ids V1, M2, N3 (LLM02)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;strokeWidth=2;fontSize=13;fontColor=#1D2433;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1325" y="160" width="320" height="150" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;8 Respond&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#5B6475&#x27;&gt;answer + citations (click → record item) · disclaimer · confidence; rendered with textContent&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3F8624;strokeWidth=2;fontSize=13;fontColor=#1D2433;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="260" y="420" width="320" height="150" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;7 Output hygiene&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#5B6475&#x27;&gt;links and identifiers removed · lengths bounded · drafts marked UNSUPPORTED (LLM05)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3F8624;strokeWidth=2;fontSize=13;fontColor=#1D2433;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="615" y="420" width="320" height="150" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;6 Grounding check&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#5B6475&#x27;&gt;citations must exist in THIS record · ungrounded statements dropped · answer withheld (LLM09)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3F8624;strokeWidth=2;fontSize=13;fontColor=#1D2433;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="970" y="420" width="320" height="150" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;5 Claude&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#5B6475&#x27;&gt;claude-opus-5-5 · messages.parse + Zod schema · token budget · circuit breaker · GenAI span (LLM10)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#191919;strokeWidth=2;fontSize=13;fontColor=#1D2433;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1325" y="420" width="320" height="150" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#232F3E;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#232F3E;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#232F3E;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#232F3E;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#232F3E;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c15" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#232F3E;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c14" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#232F3E;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#8C4FFF;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#8C4FFF;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="200" y="426"/><mxPoint x="200" y="235"/></Array></mxGeometry></mxCell><mxCell id="c24" value="&lt;b&gt;Deterministic, model-independent&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#5B6475&#x27;&gt;safety flags (allergy ↔ medication, high NEWS2) on every summary · rule-based summary when the model is unavailable, refuses, or is ungrounded&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B6475;strokeWidth=2;fontSize=12;fontColor=#1D2433;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="260" y="610" width="660" height="90" as="geometry"/></mxCell><mxCell id="c25" value="records-api" style="aspect=fixed;sketch=0;html=1;dashed=0;whitespace=wrap;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#2875E2;strokeColor=#ffffff;points=[];shape=mxgraph.kubernetes.icon2;prIcon=deploy;fontSize=11;fontStyle=1;fontColor=#1D2433;" vertex="1" parent="1"><mxGeometry x="1820" y="180" width="56" height="56" as="geometry"/></mxCell><mxCell id="c26" value="PostgreSQL" style="aspect=fixed;sketch=0;html=1;dashed=0;whitespace=wrap;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#2875E2;strokeColor=#ffffff;points=[];shape=mxgraph.kubernetes.icon2;prIcon=sts;fontSize=11;fontStyle=1;fontColor=#1D2433;" vertex="1" parent="1"><mxGeometry x="1820" y="340" width="50" height="50" as="geometry"/></mxCell><mxCell id="c27" value="GET record (audited)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#147EBA;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#147EBA;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c25"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1095" y="130"/><mxPoint x="1780" y="130"/><mxPoint x="1780" y="197"/></Array></mxGeometry></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#147EBA;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#147EBA;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c25" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="Claude API&lt;br&gt;(HTTPS, egress policy)" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;fontSize=11;fontStyle=1;fontColor=#1D2433;html=1;" vertex="1" parent="1"><mxGeometry x="1820" y="520" width="56" height="56" as="geometry"/></mxCell><mxCell id="c30" value="minimised record + task" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#191919;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#191919;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c15" target="c29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="Human in the loop (LLM06 excessive agency)" style="rounded=1;arcSize=3;fillColor=#F4FBF6;strokeColor=#3F8624;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;fontStyle=1;fontColor=#3F8624;html=1;whiteSpace=wrap;fontSize=15;" vertex="1" parent="1"><mxGeometry x="30" y="760" width="1060" height="380" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;Draft&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#5B6475&#x27;&gt;assistant writes a DRAFT note (both credentials); no tools, cannot sign or prescribe&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7B61FF;strokeWidth=2;fontSize=13;fontColor=#1D2433;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="820" width="310" height="130" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;Review&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#5B6475&#x27;&gt;clinician reads it next to the cited record items and edits it&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=2;fontSize=13;fontColor=#1D2433;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="400" y="820" width="310" height="130" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;Sign&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#5B6475&#x27;&gt;only a clinician signs (records-api refuses the assistant); signed_by, signed_at, audit&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3F8624;strokeWidth=2;fontSize=13;fontColor=#1D2433;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="820" width="310" height="130" as="geometry"/></mxCell><mxCell id="c35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#232F3E;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c32" target="c33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#232F3E;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c33" target="c34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c37" value="&lt;b&gt;What is kept:&lt;/b&gt; the record keeps each AI interaction&#x27;s metadata (feature, model, outcome, tokens, number of citations) and the audit trail keeps every read with its purpose (care, ai-summary, ai-question, ai-draft). Questions and answers are &lt;b&gt;never&lt;/b&gt; written to logs, traces or metrics." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#1D2433;" vertex="1" parent="1"><mxGeometry x="60" y="975" width="1010" height="150" as="geometry"/></mxCell><mxCell id="c38" value="Observability and AIOps (metadata only)" style="rounded=1;arcSize=3;fillColor=#F5F7FD;strokeColor=#425CC7;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;fontStyle=1;fontColor=#425CC7;html=1;whiteSpace=wrap;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1120" y="760" width="1000" height="380" as="geometry"/></mxCell><mxCell id="c39" value="OTLP" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;fontSize=11;fontStyle=1;fontColor=#1D2433;html=1;" vertex="1" parent="1"><mxGeometry x="1160" y="830" width="50" height="50" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;Metrics:&lt;/b&gt; caresignal_llm_requests_total{feature,outcome} · llm_tokens_total{direction} · llm_duration_seconds · llm_guardrail_blocks_total{reason} · llm_injection_suspected_total · llm_grounding_failures_total · llm_budget_remaining_ratio · llm_circuit_open_ratio&lt;br&gt;&lt;b&gt;Traces:&lt;/b&gt; span &lt;i&gt;chat claude-opus-5-5&lt;/i&gt; with gen_ai.* attributes (model, tokens, finish reason), inside the request trace (assistant → records-api)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#1D2433;" vertex="1" parent="1"><mxGeometry x="1240" y="810" width="860" height="170" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;Alerts → aiops-engine:&lt;/b&gt; assistant degraded / circuit open (llm-provider) · prompt-injection attempts (llm-abuse, security) · ungrounded output (llm-quality) · token budget low (llm-cost) · model latency; anomaly detection on token rate and guardrail blocks" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#1D2433;" vertex="1" parent="1"><mxGeometry x="1160" y="990" width="940" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>