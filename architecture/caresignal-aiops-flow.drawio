strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#DD344C;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="c25" target="c28"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1040" y="624"/><mxPoint x="1040" y="280"/></Array></mxGeometry></mxCell><mxCell id="c42" value="anomaly" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#ED7100;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#ED7100;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="c22" target="c28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c43" value="On-call engineer" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=1;aspect=fixed;pointerEvents=1;fillColor=#DD344C;shape=mxgraph.aws4.user;" vertex="1" parent="1"><mxGeometry x="1600" y="760" width="56" height="56" as="geometry"/></mxCell><mxCell id="c44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4A154B;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#4A154B;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c33" target="c43"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1920" y="788"/></Array></mxGeometry></mxCell><mxCell id="c45" value="&lt;b&gt;The human decides and acts:&lt;/b&gt; runbook, Grafana (metrics ↔ logs ↔ traces), roll back with &lt;i&gt;git revert&lt;/i&gt; (Argo CD), then a blameless postmortem. The engine has no write permissions." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#1D2433;" vertex="1" parent="1"><mxGeometry x="1300" y="850" width="780" height="80" as="geometry"/></mxCell><mxCell id="c46" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=#000000;verticalAlign=bottom;align=center;fontStyle=1;html=1;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="700" width="1180" height="330" as="geometry"/></mxCell><mxCell id="c47" value="LLM guardrails (OWASP Top 10 for LLM applications)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#1D2433;" vertex="1" parent="1"><mxGeometry x="75" y="708" width="1150" height="26" as="geometry"/></mxCell><mxCell id="c48" value="&lt;b&gt;LLM01 Prompt injection&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#1D2433;" vertex="1" parent="1"><mxGeometry x="80" y="750" width="280" height="50" as="geometry"/></mxCell><mxCell id="c49" value="evidence is data: JSON-escaped, &lt; &gt; escaped, system prompt forbids following it, fixed output schema" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#1D2433;" vertex="1" parent="1"><mxGeometry x="370" y="750" width="860" height="50" as="geometry"/></mxCell><mxCell id="c50" value="&lt;b&gt;LLM02 Sensitive information&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#1D2433;" vertex="1" parent="1"><mxGeometry x="80" y="804" width="280" height="50" as="geometry"/></mxCell><mxCell id="c51" value="redaction before sending; HealthTech: no PHI ever leaves the cluster" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#1D2433;" vertex="1" parent="1"><mxGeometry x="370" y="804" width="860" height="50" as="geometry"/></mxCell><mxCell id="c52" value="&lt;b&gt;LLM05 Improper output handling&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#1D2433;" vertex="1" parent="1"><mxGeometry x="80" y="858" width="280" height="50" as="geometry"/></mxCell><mxCell id="c53" value="Pydantic validation, allow-listed runbooks, links stripped, never executed (Semgrep rule)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#1D2433;" vertex="1" parent="1"><mxGeometry x="370" y="858" width="860" height="50" as="geometry"/></mxCell><mxCell id="c54" value="&lt;b&gt;LLM06 Excessive agency&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#1D2433;" vertex="1" parent="1"><mxGeometry x="80" y="912" width="280" height="50" as="geometry"/></mxCell><mxCell id="c55" value="no tools; read-only RBAC; suggestions only, humans act" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#1D2433;" vertex="1" parent="1"><mxGeometry x="370" y="912" width="860" height="50" as="geometry"/></mxCell><mxCell id="c56" value="&lt;b&gt;LLM10 Unbounded consumption&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#1D2433;" vertex="1" parent="1"><mxGeometry x="80" y="966" width="280" height="50" as="geometry"/></mxCell><mxCell id="c57" value="dedupe per alert group, hourly budget, timeouts, max tokens, fallback" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#1D2433;" vertex="1" parent="1"><mxGeometry x="370" y="966" width="860" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>