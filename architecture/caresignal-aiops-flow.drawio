=1;fontSize=11;fontStyle=1;fontColor=#DD344C;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c13" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="query_range" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#ED7100;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#ED7100;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="Alertmanager" style="aspect=fixed;sketch=0;html=1;dashed=0;whitespace=wrap;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#2875E2;strokeColor=#ffffff;points=[];shape=mxgraph.kubernetes.icon2;prIcon=pod;fontSize=11;fontStyle=1;fontColor=#1D2433;" vertex="1" parent="1"><mxGeometry x="830" y="600" width="48" height="48" as="geometry"/></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#DD344C;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#DD344C;labelBackgroundColor=#FFFFFF;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c21" target="c25"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="778" y="624"/></Array></mxGeometry></mxCell><mxCell id="c27" value="aiops-engine (namespace aiops)" style="rounded=1;arcSize=3;fillColor=#F7F7FB;strokeColor=#425CC7;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;fontStyle=1;fontColor=#425CC7;html=1;whiteSpace=wrap;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1060" y="110" width="1060" height="560" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;1 Collect evidence&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#5B6475&#x27;&gt;Prometheus value · Loki errors · Warning events · Argo CD last deploy (read-only RBAC)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#147EBA;strokeWidth=2;fontSize=13;fontColor=#1D2433;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1090" y="160" width="300" height="150" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;2 Redact&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#5B6475&#x27;&gt;secrets, tokens, DSNs, emails, NHS-like numbers, names; patient UUID → stable pseudonym&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DD344C;strokeWidth=2;fontSize=13;fontColor=#1D2433;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1430" y="160" width="300" height="150" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;3 Budget&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#5B6475&#x27;&gt;1 call per alert group / 30 min · 20 calls / hour · 60 s timeout&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;strokeWidth=2;fontSize=13;fontColor=#1D2433;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1770" y="160" width="300" height="150" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;4 Claude triage&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#5B6475&#x27;&gt;claude-opus-5-5 · structured output (Pydantic) · evidence wrapped as untrusted data · fallbacks&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#191919;strokeWidth=2;fontSize=13;fontColor=#1D2433;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1090" y="390" width="300" height="150" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;5 Validate&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#5B6475&#x27;&gt;known runbook ids only · links removed · length limits&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3F8624;strokeWidth=2;fontSize=13;fontColor=#1D2433;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1430" y="390" width="300" height="150" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;6 Slack&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#5B6475&#x27;&gt;summary · probable cause · evidence · next steps · &#x27;verify before acting&#x27;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A154B;strokeWidth=2;fontSize=13;fontColor=#1D2433;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1770" y="390" width="300" height="150" as="geometry"/></mxCell><mxCell id="c34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#232F3E;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c28" target="c29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#232F3E;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c29" target="c30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#232F3E;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" sour