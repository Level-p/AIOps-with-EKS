<mxfile host="drawio" type="device"><diagram id="CareSignal AIOps flow" name="CareSignal AIOps flow"><mxGraphModel dx="2150" dy="1060" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2150" pageHeight="1060" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="CareSignal AIOps: from telemetry to an AI-assisted, human-owned incident" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1D2433;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="34" as="geometry"/></mxCell><mxCell id="c3" value="Detection is deterministic (alert rules, statistics); the LLM only summarises redacted evidence; people decide and act" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontStyle=0;fontColor=#5B6475;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1500" height="24" as="geometry"/></mxCell><mxCell id="c4" value="vitals-ingest" style="aspect=fixed;sketch=0;html=1;dashed=0;whitespace=wrap;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#2875E2;strokeColor=#ffffff;points=[];shape=mxgraph.kubernetes.icon2;prIcon=deploy;fontSize=11;fontStyle=1;fontColor=#1D2433;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="48" height="48" as="geometry"/></mxCell><mxCell id="c5" value="records-api" style="aspect=fixed;sketch=0;html=1;dashed=0;whitespace=wrap;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#2875E2;strokeColor=#ffffff;points=[];shape=mxgraph.kubernetes.icon2;prIcon=deploy;fontSize=11;fontStyle=1;fontColor=#1D2433;" vertex="1" parent="1"><mxGeometry x="60" y="270" width="48" height="48" as="geometry"/></mxCell><mxCell id="c6" value="clinical-assistant" style="aspect=fixed;sketch=0;html=1;dashed=0;whitespace=wrap;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#2875E2;strokeColor=#ffffff;points=[];shape=mxgraph.kubernetes.icon2;prIcon=deploy;fon